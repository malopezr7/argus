    "phase1": "tsx scripts/run-phase1.ts",
    "argus": "tsx packages/cli/src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
