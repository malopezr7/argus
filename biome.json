{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": true, "includes": ["**", "!website"] },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noConfusingVoidType": "off" }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["examples/**"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off", "noShadowRestrictedNames": "off" },
          "complexity": { "useArrowFunction": "off" },
          "correctness": { "noInnerDeclarations": "off" },
          "style": { "useTemplate": "off" }
        }
      }
    }
  ]
}
